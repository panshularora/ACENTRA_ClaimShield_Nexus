CLAIMSHIELD_DATABASE_URL=sqlite+pysqlite:///./claimshield.db
CLAIMSHIELD_JWT_SIGNING_KEY=dev-only-change-me
CLAIMSHIELD_COOKIE_SECURE=false
CLAIMSHIELD_COOKIE_SAMESITE=strict
CLAIMSHIELD_DEMO_MODE=true
CLAIMSHIELD_DATA_PROFILE=tiny
CLAIMSHIELD_LLM_BASE_URL=https://api.x.ai/v1
CLAIMSHIELD_LLM_API_KEY=
CLAIMSHIELD_LLM_MODEL=grok-4.7

# Leave empty for local development. Local POST /api/v1/batches still works.
CLAIMSHIELD_INTERNAL_TOKEN=

# Used only when the API fetches S3 objects (production / Lambda trigger).
# Unprefixed aliases also work: AWS_REGION, S3_BUCKET, S3_INPUT_PREFIX,
# S3_PROCESSED_PREFIX, S3_RESULTS_PREFIX, LAMBDA_FUNCTION.
CLAIMSHIELD_AWS_REGION=ap-south-1
CLAIMSHIELD_S3_BUCKET=claimshield-nexus-data-2026
CLAIMSHIELD_S3_INCOMING_PREFIX=incoming/
CLAIMSHIELD_S3_PROCESSED_PREFIX=processed/
CLAIMSHIELD_S3_RESULTS_PREFIX=results/
CLAIMSHIELD_LAMBDA_FUNCTION=claimshield-s3-processor

# AWS-free ingest tests: map s3://bucket/key to this directory.
# CLAIMSHIELD_S3_LOCAL_DIR=/tmp/claimshield-s3
